{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:openssf-scorecard",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "The package has no runtime dependencies, CI tests every update. Waiting a week gives npm time to pull compromised releases before they reach the job that publishes.",
      "matchPackageNames": ["*"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "minimumReleaseAge": null
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
